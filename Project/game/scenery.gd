extends GameRoutines
## The kinds of scenery a course can have, 375 of them: what sets each up
## when it comes into the window that course_objects.gd keeps around the
## camera, and the two kinds that do more than stand there: what a car
## knocks over, and what crosses the course.
##
## A kind's number is also the number of its (first) picture. The slot of
## the thing is in A1 throughout.

const Sprite := preload("res://game/sprite_object.gd")
const Objects := preload("res://game/course_objects.gd")

## Of course_objects.gd.
const PLACE := 0x141AA
const REMOVE := 0x14240
const ADD_EFFECT := 0x1458C
const REQUEST_SOUND := 0x15256
const TOWARDS := 0x1014C
const SINE := 0x27A3A
## Where the player's car is and how fast it goes (car.gd's CAR_REPORT).
const CAR_X := 0x10165E
const CAR_Y := 0x101660
const CAR_SPEED := 0x101662

# --- what a car knocks over --------------------------------------------------

## Its fields, where scenery that stands has others: the first of its 12
## pictures turning round (the picture after the first four lies flat), 1
## once it was hit, frames it has lain, where it is (16.16), which way and
## how fast it was thrown, how high it is and how fast it rises (16.16),
## and which picture of its turn shows (16.16) and how fast that goes on.
const FIRST_PICTURE := 0x10
const HIT := 0x12
const FRAMES_LAIN := 0x14
const THROWN_X := 0x16
const THROWN_Y := 0x1A
const THROWN_TOWARDS := 0x1E
const THROWN_SPEED := 0x20
const HEIGHT := 0x24
const RISE := 0x28
const TURN := 0x2C
const TURN_SPEED := 0x30
## How near the car must come, in pixels across and down.
const REACH := 0x30
const PICTURES_OF_TURN := 12
const LYING_PICTURE := 4
## It lies for this many frames, shown on every other, and is gone.
const FRAMES_LYING := 0x1E
const GRAVITY := 0x10000
## A bounce weaker than this ends the flight.
const LAST_BOUNCE := 0x10000
const FIRST_TURN_SPEED := 0x8000
const SPEED_TAKEN := 0xE0
## Kinds from this picture on are the heavier sort.
const HEAVY_FROM := 0x5A
const SOUND_LIGHT := 0xD2
const SOUND_HEAVY := 0xCE
const EFFECT_KNOCK := 6
const KNOCKED_OFFSET_X := 0x10
const KNOCKED_OFFSET_Y := 0x18
const DEPTH_IN_FRONT := 0x4000

# --- what crosses the course -------------------------------------------------

## Its fields: 0 going left and 1 going right, its step of 16, and the
