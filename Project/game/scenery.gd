const PICTURE_BY_STEP := [0x2E714, 0x2E754]
const LIFT_BY_STEP := [0x2E734, 0x2E774]
const FIRST_PICTURES := [0xB4, 0xBA]
const CROSSING_OFFSET_X := 0x10
const LIFT_LEAST := 0x1C
const SECOND_OFFSET_Y := 8
const SECOND_DEPTH := 0xFFF0
## The one kind that goes left.
const KIND_GOING_LEFT := 0xB4


