func routines() -> Dictionary:
	var table := {
		0x16B2A: nothing_to_remove,
		0x16B4C: nothing_to_remove,
		0x16B9A: nothing_to_remove,
		0x16BF0: nothing_to_remove,
		0x16BF2: knocked_over,
		0x16E50: remove_crossing,
		0x16E62: cross,
	}
	for address: int in STANDING:
		var kind: Array = STANDING[address]
		table[address] = set_up_standing.bind(kind[0], kind[1], kind[2], kind[3])
	for address: int in FLUTTERING:
		var kind: Array = FLUTTERING[address]
		table[address] = set_up_moving.bind(kind[0], kind[1], kind[2])
	for address: int in SWAYING:
		var kind: Array = SWAYING[address]
		table[address] = set_up_moving.bind(kind[0], kind[1], kind[2])
	for address: int in KNOCKED_OVER:
		table[address] = set_up_knocked_over.bind(KNOCKED_OVER[address][0])
	for address: int in CROSSING:
		table[address] = set_up_crossing.bind(CROSSING[address][0])
	return table


func scratch() -> Dictionary:
	var drawing := ["d0", "d1", "d2", "d3", "a0", "a3", "ccr"]
	var table := {}
	for address: int in routines():
		table[address] = drawing
	return table


func _scenery_picture(number: int) -> int:
	return m.r32(m.r32(Objects.SCENERY_PICTURES) + wrap16(number * 4))


func _place(across: int, down: int, depth: int) -> void:
	m.d0 = with_low16(m.d0, across)
	m.d2 = with_low16(m.d2, down)
	m.d1 = with_low16(m.d1, depth)
	m.call_routine(PLACE)


## $16B2A and others: these kinds keep nothing that must be given back.
func nothing_to_remove() -> void:
	pass


## $16FEA and on, through $16B04.
func set_up_standing(across: int, down: int, depth: int, kind: int) -> void:
	var slot := m.a1
	set16(slot + Objects.OFFSET_X, across)
	set16(slot + Objects.OFFSET_Y, down)
	set16(slot + Objects.DEPTH, depth)
	Sprite.picture(m, u32(slot + Objects.SPRITE), _scenery_picture(kind))


## $1734A and on, through $16B3E; $19A08 through $16B8C.
func set_up_moving(across: int, down: int, kind: int) -> void:
	var slot := m.a1
	set16(slot + Objects.OFFSET_X, across)
	set16(slot + Objects.OFFSET_Y, down)
	set16(slot + Objects.DEPTH, kind)


## $177BE and two more, through $16BEA.
func set_up_knocked_over(kind: int) -> void:
	var slot := m.a1
	set16(slot + FIRST_PICTURE, kind)
	set16(slot + HIT, 0)


## $16BF2: a frame of a thing a car can knock over. It stands until the
## player's car comes within REACH, is then thrown the way the car pushed
## it at a part of the car's speed, turning in the air and bouncing lower
## each time, and at last lies flat, blinks and is gone.
func knocked_over() -> void:
	var slot := m.a1
	var sprite := u32(slot + Objects.SPRITE)
	if u16(slot + HIT) == 0:
		if _apart(u16(CAR_X), u16(slot + Objects.X)) >= REACH \
				or _apart(u16(CAR_Y), u16(slot + Objects.Y)) >= REACH:
			Sprite.picture(m, sprite, _scenery_picture(u16(slot + FIRST_PICTURE)))
			_place(KNOCKED_OFFSET_X, KNOCKED_OFFSET_Y, 0)
			return
		_knock(slot)
	if u16(slot + FRAMES_LAIN) == 0 and _fly(slot):
		Sprite.picture(m, sprite, _scenery_picture(u16(slot + FIRST_PICTURE) + u16(slot + TURN)))
	else:
		if u16(slot + FRAMES_LAIN) == FRAMES_LYING:
			m.call_routine(REMOVE)
			return
		var lain := u16(slot + FRAMES_LAIN) + 1
		set16(slot + FRAMES_LAIN, lain)
		Sprite.picture(m, sprite, _scenery_picture(u16(slot + FIRST_PICTURE) + LYING_PICTURE))
		Sprite.show(m, sprite, lain & 1 == 1)
	set16(slot + Objects.X, u16(slot + THROWN_X))
	set16(slot + Objects.Y, u16(slot + THROWN_Y) - u16(slot + HEIGHT))
	_place(KNOCKED_OFFSET_X, KNOCKED_OFFSET_Y, DEPTH_IN_FRONT)


## How far apart two coordinates are, as the original counts it.
func _apart(car: int, thing: int) -> int:
	var apart := (car - thing) & 0xFFFF
	return (-apart) & 0xFFFF if car < thing else apart


## The car has reached it: throws it away from the car.
func _knock(slot: int) -> void:
	m.d0 = with_low16(m.d0, SOUND_LIGHT if u16(slot + FIRST_PICTURE) < HEAVY_FROM else SOUND_HEAVY)
	m.call_routine(REQUEST_SOUND)
	set16(slot + HIT, u16(slot + HIT) + 1)
	set16(slot + FRAMES_LAIN, 0)
	var x := u16(slot + Objects.X)
	var y := u16(slot + Objects.Y)
	set32(slot + THROWN_X, x << 16)
	set32(slot + THROWN_Y, y << 16)
	m.d2 = with_low16(m.d2, x - u16(CAR_X))
	m.d3 = with_low16(m.d3, y - u16(CAR_Y))
	m.call_routine(TOWARDS)
	set16(slot + THROWN_TOWARDS, low16(m.d0) << 8)
	var speed := s16(CAR_SPEED) * SPEED_TAKEN
	set32(slot + THROWN_SPEED, speed)
	set32(slot + HEIGHT, 0)
	set32(slot + RISE, speed)
	set32(slot + TURN, 0)
	set32(slot + TURN_SPEED, FIRST_TURN_SPEED)
	m.d0 = with_low16(m.d0, x)
	m.d2 = with_low16(m.d2, y)
	m.d1 = with_low16(m.d1, 0x100)
	m.d3 = with_low16(m.d3, EFFECT_KNOCK)
	m.call_routine(ADD_EFFECT)


## A frame of its flight. Returns false when it has come to rest.
func _fly(slot: int) -> bool:
	var speed := wrap16(u32(slot + THROWN_SPEED) >> 8)
	var towards := u16(slot + THROWN_TOWARDS)
	var across := rom_s16(SINE + ((((towards + 0x4000) & 0xFFFF) >> 5) & 0xFFFE))
	var down := rom_s16(SINE + ((towards >> 5) & 0xFFFE))
	set32(slot + THROWN_X, u32(slot + THROWN_X) + across * speed)
	set32(slot + THROWN_Y, u32(slot + THROWN_Y) + down * speed)
	var rise := s32(slot + RISE)
	var height := wrap32(s32(slot + HEIGHT) + rise)
	if height < 0:
		# it bounces, half as fast
		height = wrap32(-height)
		rise = (wrap32(-rise) & 0xFFFFFFFF) >> 1
		if rise < LAST_BOUNCE:
			set16(slot + FRAMES_LAIN, u16(slot + FRAMES_LAIN) + 1)
			return false
		set32(slot + THROWN_SPEED, s32(slot + THROWN_SPEED) >> 1)
	set32(slot + HEIGHT, height)
	set32(slot + RISE, rise - GRAVITY)
	var turn := u32(slot + TURN)
	var turn_speed := s32(slot + TURN_SPEED)
	turn = (turn + turn_speed) & 0xFFFFFFFF
	if turn_speed >= 0:
		if turn >= PICTURES_OF_TURN << 16:
			turn &= 0xFFFF
	elif turn & 0x80000000:
		turn = (turn & 0xFFFF) | ((PICTURES_OF_TURN - 1) << 16)
	set32(slot + TURN, turn)
	return true


## $18580 and eleven more, through $16E40.
func set_up_crossing(kind: int) -> void:
	var slot := m.a1
	set16(slot + GOING_RIGHT, 0 if kind == KIND_GOING_LEFT else 1)
	set16(slot + STEP, 0)
	set32(slot + SECOND_SPRITE, Sprite.take_record(m))


## $16E50
func remove_crossing() -> void:
	var second := u32(m.a1 + SECOND_SPRITE)
	if second != 0:
		Sprite.free_record(m, second)


## $16E62: a frame of a thing that crosses the course, in two parts.
func cross() -> void:
	var slot := m.a1
	var right := 0 if u16(slot + GOING_RIGHT) == 0 else 1
	set16(slot + Objects.Y, u16(slot + Objects.Y) - UP_A_FRAME)
	set16(slot + Objects.X, u16(slot + Objects.X) + (ACROSS_A_FRAME if right == 1 else -ACROSS_A_FRAME))
	var step := (u16(slot + STEP) + 1) & 0xF
	set16(slot + STEP, step)
	var picture: int = rom_u16(PICTURE_BY_STEP[right] + step * 2) * 2 + FIRST_PICTURES[right]
	var sprite := u32(slot + Objects.SPRITE)
	Sprite.picture(m, sprite, _scenery_picture(picture))
	_place(CROSSING_OFFSET_X, rom_u16(LIFT_BY_STEP[right] + step * 2) * 2 + LIFT_LEAST, 0)
	var second := u32(slot + SECOND_SPRITE)
	if second == 0:
		return
	Sprite.picture(m, second, _scenery_picture(picture + 1))
	set32(slot + Objects.SPRITE, second)
	_place(CROSSING_OFFSET_X, SECOND_OFFSET_Y, SECOND_DEPTH)
	set32(slot + Objects.SPRITE, sprite)
